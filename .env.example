# Copy this file to .env, then run: php artisan key:generate
# Defaults below match a fresh XAMPP on Windows.

APP_NAME="AI Messaging Sales Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Where the project is opened in the browser. With XAMPP and the project in htdocs\aichat:
APP_URL=http://localhost/aichat/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# XAMPP MySQL / MariaDB: user root, empty password. Create the database "aichat" in phpMyAdmin first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aichat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# log = emails are written to storage/logs/laravel.log (free, for your own computer). Use smtp for real sending.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# n8n (optional). Leave N8N_WEBHOOK_URL empty to run without n8n.
# After importing the starter workflow and activating it, use its Production URL:
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/aichat
N8N_WEBHOOK_URL=
N8N_SECRET=

# Google Calendar (optional). Path to a service account key file, for example C:\xampp\htdocs\aichat\storage\google.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta (WhatsApp, Messenger, Instagram). One Meta app for all businesses. See README, Step 4.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# AI mode (step 5b). AI_PROVIDER: off (default), fake (pretend AI, free) or claude (real, needs the key).
AI_PROVIDER=off
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Billing: local = test mode, nobody is charged. A real provider is added at go-live.
BILLING_PROVIDER=local
# stripe needs these four (docs/GO-LIVE.md section 5):
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# open = anyone can sign up. invite = a code from the platform console is needed (the private beta).
SIGNUP_MODE=open
